<?xml version="1.0"?>
<!--
  Minimal 7-joint FR3-like arm with MOCK ros2_control hardware.

  Deliberately hand-written rather than xacro'd out of franka_description: we
  only need joint NAMES (fr3_joint1..7) and effort command interfaces, and this
  keeps T4 independent of franka_description's mesh/xacro machinery.

  mock_components/GenericSystem exports position/velocity/effort per joint.  It
  does NOT export franka_hardware's `fr3/robot_model` and `fr3/robot_state`
  interfaces -- which is exactly the point of T4.
-->
<robot name="fr3_mock">

  <link name="world"/>
  <link name="fr3_link0"/>
  <joint name="fr3_world_joint" type="fixed">
    <parent link="world"/>
    <child link="fr3_link0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="fr3_link1"/>
  <joint name="fr3_joint1" type="revolute">
    <parent link="fr3_link0"/><child link="fr3_link1"/>
    <origin xyz="0 0 0.333" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.7437" upper="2.7437" effort="87" velocity="2.62"/>
  </joint>

  <link name="fr3_link2"/>
  <joint name="fr3_joint2" type="revolute">
    <parent link="fr3_link1"/><child link="fr3_link2"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.7837" upper="1.7837" effort="87" velocity="2.62"/>
  </joint>

  <link name="fr3_link3"/>
  <joint name="fr3_joint3" type="revolute">
    <parent link="fr3_link2"/><child link="fr3_link3"/>
    <origin xyz="0 -0.316 0" rpy="1.5708 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.9007" upper="2.9007" effort="87" velocity="2.62"/>
  </joint>

  <link name="fr3_link4"/>
  <joint name="fr3_joint4" type="revolute">
    <parent link="fr3_link3"/><child link="fr3_link4"/>
    <origin xyz="0.0825 0 0" rpy="1.5708 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.0421" upper="-0.1518" effort="87" velocity="2.62"/>
  </joint>

  <link name="fr3_link5"/>
  <joint name="fr3_joint5" type="revolute">
    <parent link="fr3_link4"/><child link="fr3_link5"/>
    <origin xyz="-0.0825 0.384 0" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.8065" upper="2.8065" effort="12" velocity="5.26"/>
  </joint>

  <link name="fr3_link6"/>
  <joint name="fr3_joint6" type="revolute">
    <parent link="fr3_link5"/><child link="fr3_link6"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/><axis xyz="0 0 1"/>
    <limit lower="0.5445" upper="4.5169" effort="12" velocity="4.18"/>
  </joint>

  <link name="fr3_link7"/>
  <joint name="fr3_joint7" type="revolute">
    <parent link="fr3_link6"/><child link="fr3_link7"/>
    <origin xyz="0.088 0 0" rpy="1.5708 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.0159" upper="3.0159" effort="12" velocity="5.26"/>
  </joint>

  <link name="fr3_link8"/>
  <joint name="fr3_joint8" type="fixed">
    <parent link="fr3_link7"/><child link="fr3_link8"/>
    <origin xyz="0 0 0.107" rpy="0 0 0"/>
  </joint>

  <ros2_control name="FR3MockSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="mock_sensor_commands">false</param>
      <param name="state_following_offset">0.0</param>
    </hardware>

    <joint name="fr3_joint1">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="fr3_joint2">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">-0.7854</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="fr3_joint3">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="fr3_joint4">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">-2.3562</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="fr3_joint5">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="fr3_joint6">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">1.5708</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="fr3_joint7">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.7854</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </ros2_control>
</robot>
