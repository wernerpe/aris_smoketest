From 12652469a84463f5cef49e2211cf7179a6dde705 Mon Sep 17 00:00:00 2001
From: ARIS <aris@local>
Date: Sun, 31 May 2026 15:18:30 -0400
Subject: [PATCH] ARIS local patch: namespaced RViz + inverted world-mount (arm
 31). NOT for upstream push.

---
 .../launch/moveit.launch.py                   | 85 +++++++++++++++----
 1 file changed, 70 insertions(+), 15 deletions(-)

diff --git a/franka_fr3_moveit_config/launch/moveit.launch.py b/franka_fr3_moveit_config/launch/moveit.launch.py
index bbec286..ca17d43 100644
--- a/franka_fr3_moveit_config/launch/moveit.launch.py
+++ b/franka_fr3_moveit_config/launch/moveit.launch.py
@@ -23,6 +23,7 @@ from launch.actions import (
     DeclareLaunchArgument,
     ExecuteProcess,
     IncludeLaunchDescription,
+    OpaqueFunction,
     Shutdown
 )
 from launch.conditions import UnlessCondition
@@ -79,10 +80,18 @@ def generate_launch_description():
         'robots', 'fr3', 'fr3.urdf.xacro'
     )
 
+    # ARIS: forward the opt-in inverted-mount args (scalar, no spaces) so an
+    # inverted arm (namespace arm_31/71/107/991) builds a base flipped to hang
+    # from the boom -> RViz + planning match reality; floor arms unchanged.
     robot_description_config = Command(
         [FindExecutable(name='xacro'), ' ', franka_xacro_file, ' hand:=', load_gripper,
          ' robot_ip:=', robot_ip, ' ee_id:=', ee_id, ' use_fake_hardware:=', use_fake_hardware,
-         ' fake_sensor_commands:=', fake_sensor_commands, ' ros2_control:=true'])
+         ' fake_sensor_commands:=', fake_sensor_commands, ' ros2_control:=true',
+         ' mount_to_world:=', LaunchConfiguration('mount_to_world'),
+         ' mroll:=', LaunchConfiguration('mroll'),
+         ' mpitch:=', LaunchConfiguration('mpitch'),
+         ' myaw:=', LaunchConfiguration('myaw'),
+         ' mz:=', LaunchConfiguration('mz')])
 
     robot_description = {'robot_description': ParameterValue(
         robot_description_config, value_type=str)}
@@ -181,24 +190,60 @@ def generate_launch_description():
         ],
     )
 
-    # RViz
+    # RViz — built per-namespace so an arm launched as namespace:=arm_31 gets
+    # an RViz that actually shows arm_31 (its move_group, planning scene, robot
+    # model), not the root arm 13.  ROOT (ns='') stays byte-identical upstream.
+    #
+    # Approach (standard MoveIt multi-robot): keep the RViz node in the ROOT
+    # namespace but (a) give it a unique node name per arm so arm 13's /rviz2
+    # and arm 31's /rviz2_arm_31 don't collide, and (b) bake the namespace into
+    # the config — 'Move Group Namespace: <ns>' (so the MotionPlanning plugin
+    # talks to /<ns>/move_group + /<ns>/get_planning_scene) and rewrite the
+    # absolute display topics to /<ns>/*.  NOTE: do NOT also put the node in the
+    # namespace — that double-prefixes the plugin's service calls
+    # (/<ns>/<ns>/get_planning_scene) and the scene never loads.
     rviz_base = os.path.join(get_package_share_directory(
         'franka_fr3_moveit_config'), 'rviz')
     rviz_full_config = os.path.join(rviz_base, 'moveit.rviz')
 
-    rviz_node = Node(
-        package='rviz2',
-        executable='rviz2',
-        name='rviz2',
-        output='log',
-        arguments=['-d', rviz_full_config],
-        parameters=[
-            robot_description,
-            robot_description_semantic,
-            ompl_planning_pipeline_config,
-            kinematics_config,
-        ],
-    )
+    def _make_rviz_node(context, *args, **kwargs):
+        ns = LaunchConfiguration('namespace').perform(context).strip('/')
+        if not ns:
+            cfg = rviz_full_config          # root arm 13 — unchanged
+            rviz_name = 'rviz2'
+        else:
+            with open(rviz_full_config) as _f:
+                txt = _f.read()
+            p = '/' + ns
+            txt = txt.replace('Move Group Namespace: ""',
+                              'Move Group Namespace: ' + ns)
+            txt = txt.replace('/monitored_planning_scene',
+                              p + '/monitored_planning_scene')
+            txt = txt.replace('/display_planned_path',
+                              p + '/display_planned_path')
+            txt = txt.replace('/rviz_visual_tools', p + '/rviz_visual_tools')
+            txt = txt.replace('Value: /initialpose', 'Value: ' + p + '/initialpose')
+            txt = txt.replace('Value: /goal_pose', 'Value: ' + p + '/goal_pose')
+            txt = txt.replace('Value: /clicked_point', 'Value: ' + p + '/clicked_point')
+            cfg = os.path.join('/tmp', 'moveit_' + ns + '.rviz')
+            with open(cfg, 'w') as _f:
+                _f.write(txt)
+            rviz_name = 'rviz2_' + ns
+        return [Node(
+            package='rviz2',
+            executable='rviz2',
+            name=rviz_name,
+            output='log',
+            arguments=['-d', cfg],
+            parameters=[
+                robot_description,
+                robot_description_semantic,
+                ompl_planning_pipeline_config,
+                kinematics_config,
+            ],
+        )]
+
+    rviz_node = OpaqueFunction(function=_make_rviz_node)
 
     # Publish TF
     robot_state_publisher = Node(
@@ -299,6 +344,16 @@ def generate_launch_description():
     return LaunchDescription(
         [robot_arg,
          namespace_arg,
+         DeclareLaunchArgument('mount_to_world', default_value='false',
+             description='ARIS: mount base to world inverted (ceiling arms)'),
+         DeclareLaunchArgument('mroll', default_value='0',
+             description='ARIS: base roll (rad)'),
+         DeclareLaunchArgument('mpitch', default_value='0',
+             description='ARIS: base pitch (rad); pi flips tool axis down (ceiling arms)'),
+         DeclareLaunchArgument('myaw', default_value='0',
+             description='ARIS: base yaw (rad)'),
+         DeclareLaunchArgument('mz', default_value='0',
+             description='ARIS: base height (m) above world/table-surface frame'),
          load_gripper_arg,
          ee_id_arg,
          use_fake_hardware_arg,
